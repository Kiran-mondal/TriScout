{
  "version": 2,
  "builds": [
    {
      "src": "web_dashboard/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "web_dashboard/views/**",
          "public/**"
        ]
      }
    },
    {
      "src": "api/scanner.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/processor.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/scanner",
      "dest": "/api/scanner.go"
    },
    {
      "src": "/api/processor",
      "dest": "/api/processor.py"
    },
    {
      "src": "/(style\\.css|logo\\.svg|sitemap\\.xml|robots\\.txt|llms\\.txt|css/.*|js/.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800",
        "X-Content-Type-Options": "nosniff"
      },
      "dest": "/web_dashboard/server.js"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate",
        "Vary": "Accept",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      },
      "dest": "/web_dashboard/server.js"
    }
  ]
}
